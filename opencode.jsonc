{
  "$schema": "https://opencode.ai/config.json",

  // Проектный конфиг OpenCode для EWR.
  // Жёсткие правила и протокол планов — в AGENTS.md (грузится автоматически).
  // Глобальный план проекта — docs/engine/PLAN.md; индекс планов подпунктов —
  // docs/engine/plans/README.md (подключаем явно, чтобы всегда быть в контексте агента).

  // Основной агент сессии по умолчанию.
  "default_agent": "build",

  // Доп. инструкции помимо авто-обнаруженного AGENTS.md.
  "instructions": [
    "docs/engine/PLAN.md",
    "docs/engine/plans/README.md"
  ],

  // Безопасность: коммит и пуш всегда спрашиваем, а не делаем молча.
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" }
  ],

  // Референс-ассеты оригинального EWB и служебные каталоги не должны
  // триггерить файловый вотчер/снапшоты — они большие и read-only.
  "watcher": {
    "ignore": [
      "EWB512/**",
      "extracted_assets/**",
      "node_modules/**",
      "docs/re/_dec/**"
    ]
  }
}
